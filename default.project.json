{
  "name": "gym-simulator",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Modules": {
        "$path": "src/ReplicatedStorage/Modules"
      },
      "Packages": {
        "$path": "Packages"
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "Core": {
        "$path": "src/ServerScriptService/Core"
      },
      "Bootstrap": {
        "$path": "src/ServerScriptService/Bootstrap.server.luau"
      },
      "ServerPackages": {
        "$path": "ServerPackages"
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "Controllers": {
          "$path": "src/StarterPlayer/StarterPlayerScripts/Controllers"
        },
        "Bootstrap": {
          "$path": "src/StarterPlayer/StarterPlayerScripts/Bootstrap.client.luau"
        }
      }
    },
    "Workspace": {
      "$properties": {
        "FilteringEnabled": true,
        "StreamingEnabled": true,
        "StreamingTargetRadius": 512,
        "StreamingMinRadius": 128,
        "StreamingIntegrityMode": "PauseOutsideLoadedArea"
      },
      "Gym": {
        "$path": "src/Workspace/Gym"
      },
      "SpawnLocation": {
        "$className": "SpawnLocation",
        "$properties": {
          "Anchored": true,
          "CanCollide": false,
          "Transparency": 1,
          "Size": [
            10,
            1,
            10
          ],
          "Position": [
            0,
            2.3,
            0
          ],
          "Neutral": true,
          "Duration": 0
        }
      }
    },
    "Lighting": {
      "$properties": {
        "Ambient": [
          0.09,
          0.09,
          0.11
        ],
        "Brightness": 2,
        "GlobalShadows": true,
        "Outlines": false,
        "Technology": "Voxel"
      }
    },
    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    },
    "Players": {
      "$properties": {
        "RespawnTime": 4,
        "CharacterAutoLoads": true
      }
    }
  }
}