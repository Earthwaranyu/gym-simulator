{
  "name": "gym-simulator",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Modules": {
        "$path": "src/ReplicatedStorage/Modules"
      },
      "Packages": {
        "$path": "Packages"
      }
    },
    "ReplicatedFirst": {
      "$className": "ReplicatedFirst",
      "Boot": {
        "$path": "src/ReplicatedFirst/Boot.client.luau"
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "Core": {
        "$path": "src/ServerScriptService/Core"
      },
      "Bootstrap": {
        "$path": "src/ServerScriptService/Bootstrap.server.luau"
      },
      "ServerPackages": {
        "$path": "ServerPackages"
      }
    },
    "StarterGui": {
      "$className": "StarterGui",
      "$properties": {
        "ClipsDescendantsSupportsRotation": "Enabled"
