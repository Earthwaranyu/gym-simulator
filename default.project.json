{
  "name": "gym-simulator",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Modules": {
        "$path": "src/ReplicatedStorage/Modules"
      },
      "Packages": {
        "$path": "Packages"
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "Core": {
        "$path": "src/ServerScriptService/Core"
      },
      "Bootstrap": {
        "$path": "src/ServerScriptService/Bootstrap.server.luau"
      },
      "ServerPackages": {
        "$path": "ServerPackages"
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "$properties": {
        "LoadCharacterAppearance": false,
        "CharacterUseJumpPower": true
      },
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "Controllers": {
          "$path": "src/StarterPlayer/StarterPlayerScripts/Controllers"
        },
        "Bootstrap": {
          "$path": "src/StarterPlayer/StarterPlayerScripts/Bootstrap.client.luau"
        }
      }
    },
    "Workspace": {
      "$properties": {
        "FilteringEnabled": true,
        "StreamingEnabled": true,
        "StreamingTargetRadius": 512,
        "StreamingMinRadius": 128,
        "StreamingIntegrityMode": "PauseOutsideLoadedArea"
      },
      "Gym": {
        "$path": "src/Workspace/Gym"
      },
      "SpawnLocation": {
        "$className": "SpawnLocation",
        "$properties": {
          "Anchored": true,
          "CanCollide": false,
          "Transparency": 1,
          "Size": [
            10,
            1,
            10
          ],
          "Position": [
            0,
            2.3,
            0
          ],
          "Neutral": true,
          "Duration": 0
        }
      }
    },
    "Lighting": {
      "$properties": {
        "Ambient": [
          0.12,
          0.11,
          0.09
        ],
        "OutdoorAmbient": [
          0.35,
          0.33,
          0.28
        ],
        "Brightness": 2.5,
        "ClockTime": 15.5,
        "GeographicLatitude": 33.9,
        "GlobalShadows": true,
        "Outlines": false,
        "Technology": "Future",
        "EnvironmentDiffuseScale": 0.75,
        "EnvironmentSpecularScale": 0.5,
        "ColorShift_Top": [
          1,
          0.95,
          0.85
        ],
        "ColorShift_Bottom": [
          0.6,
          0.55,
          0.5
        ],
        "ExposureCompensation": 0.15
      },
      "Atmosphere": {
        "$className": "Atmosphere",
        "$properties": {
          "Density": 0.2,
          "Offset": 0.25,
          "Color": [
            0.85,
            0.82,
            0.73
          ],
          "Decay": [
            0.7,
            0.62,
            0.5
          ],
          "Glare": 0.15,
          "Haze": 1.2
        }
      },
      "Bloom": {
        "$className": "BloomEffect",
        "$properties": {
          "Intensity": 0.35,
          "Size": 28,
          "Threshold": 1.5
        }
      },
      "ColorCorrection": {
        "$className": "ColorCorrectionEffect",
        "$properties": {
          "Brightness": 0.02,
          "Contrast": 0.08,
          "Saturation": 0.12,
          "TintColor": [
            1,
            0.96,
            0.88
          ]
        }
      },
      "SunRays": {
        "$className": "SunRaysEffect",
        "$properties": {
          "Intensity": 0.06,
          "Spread": 0.7
        }
      }
    },
    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    },
    "Players": {
      "$properties": {
        "RespawnTime": 4,
        "CharacterAutoLoads": true
      }
    }
  }
}
